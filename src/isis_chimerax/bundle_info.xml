<BundleInfo name="ChimeraX-ISIS"
            version="2.0.0"
            package="isis_chimerax"
            minSessionVersion="1" maxSessionVersion="1">

  <Author>NanoSyrinx</Author>
  <Email>support@nanosyrinx.com</Email>
  <URL>https://github.com/nanosyrinx/isis</URL>

  <Synopsis>B-cell epitope prediction and visualization</Synopsis>
  <Description>
ISIS (In Silico Immunogenicity Studies) provides B-cell epitope
prediction using established amino acid property scales.
  </Description>

  <Categories>
    <Category name="Sequence"/>
    <Category name="Structure Analysis"/>
  </Categories>

  <Dependencies>
    <Dependency name="ChimeraX-Core" version=">=1.0"/>
    <Dependency name="ChimeraX-Atomic" version=">=1.0"/>
  </Dependencies>

  <Providers manager="commands">
    <Provider name="isis predict"/>
    <Provider name="isis color"/>
    <Provider name="isis epitopes"/>
    <Provider name="isis clear"/>
    <Provider name="isis list"/>
  </Providers>

  <Classifiers>
    <PythonClassifier>Development Status :: 4 - Beta</PythonClassifier>
    <PythonClassifier>License :: OSI Approved :: MIT License</PythonClassifier>
  </Classifiers>

</BundleInfo>
